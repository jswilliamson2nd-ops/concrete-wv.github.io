    .nav{display:flex;align-items:flex-end;justify-content:space-between;gap:16px;padding:8px 0;flex-wrap:wrap}
    .logo-wrap{display:inline-flex;align-items:flex-end;gap:12px;margin-left:-4px}
    .logo-img{height:60px;filter:drop-shadow(0 6px 16px rgba(0,0,0,.35))}
    nav{display:flex;align-items:center;gap:10px;flex-wrap:wrap}
    nav a{color:var(--text-dim);padding:6px 2px} nav a.active{color:var(--accent);font-weight:600}
    .breadcrumb{font-size:14px;margin:8px 0 0;color:var(--text-dim)}
    .page-title{padding:30px 0 12px}
    .grid{display:grid;grid-template-columns:1fr;gap:18px;margin:18px 0 46px}
    .card{border:1px solid var(--border);border-radius:16px;background:var(--card);padding:18px;box-shadow:var(--shadow)}
    .muted{color:var(--text-dim)} .cta-row{display:flex;gap:10px;flex-wrap:wrap}
    .btn{display:inline-block;padding:10px 14px;border-radius:10px;border:1px solid var(--border)} .btn.primary{background:var(--accent);color:#062522;border:none;font-weight:600}
    code,kbd{background:#0e1628;border:1px solid var(--border);padding:2px 6px;border-radius:6px}
  </style>
